node_modules

# The beads task ledger's local database. It sits at the REPOSITORY ROOT, is shared by every lane on this
# VM, and syncs through refs/dolt/data on the git remote rather than through working-tree files - so its
# local bytes never belong in a commit. Without these lines the files are untracked but NOT ignored, and a
# routine `git add -A` stages ~2 MB of database internals, including a merge-conflict surface nobody can
# resolve. Anchored with a leading `/` so a directory that merely happens to be named `embeddeddolt`
# deeper in the tree is not silently ignored along with it (mwg-train-1pm).
/embeddeddolt/
/embeddeddolt.gate.lock
/last-touched

# The viewer's runtime state: sandbox bridge sockets and regenerated uplifted trees.
.viewer-state/

# Test fixture databases.
test-fixtures/**/*.sqlite
npm-debug.log*

# Raw captured licence/terms bytes and their text extractions are kept locally for review but not
# redistributed from this repository. The committed manifest at
# docs/provenance/evidence/manifest.jsonl carries url + fetched_at + sha256 for every capture, so a
# reviewer can re-fetch the same source and verify the quoted clauses against the same bytes.
docs/provenance/evidence/raw/
docs/provenance/evidence/text/

# Provider pages are fetched to derive the priced sheet; we do not redistribute them.
# fetched.json (URLs, dates, byte counts, sha256) IS committed so anyone can re-fetch and check.
docs/eval/quotes.raw/*
!docs/eval/quotes.raw/fetched.json

# Pilot run output: records, screenshots and traces are evidence, regenerated per run.
pilot/out/
# Uplifted copies of the pilot projects: regenerated per run, inside the repo so module resolution works.
.pilot-uplifted/
.pilot-corpus/
# Uplifted copies of the training-corpus projects (scripts/train-corpus-run.mjs): regenerated per run.
.train-uplifted/
# Conformance runs: the generated corpus and the uplifted copies are rebuilt per run.
.conformance-corpus/
.conformance-uplifted/
# Training corpus projects: 210 trees (30 families x 7 frameworks) rebuilt deterministically per run.
# pilot/TRAINING_CORPUS.json records every tree hash, and scripts/scaffold-training-corpus.mjs
# asserts zero collisions against the pilot corpus, so the trees do not need to be tracked to be
# verifiable - and 1,320 generated files in every clone forever is a poor trade for that.
pilot/training-projects/
