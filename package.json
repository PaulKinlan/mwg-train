{
  "name": "mwg-train",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Experiment: does training on Modern Web Guidance-applied sites make a model default to modern web practice? Corpus, uplift pairing, adapter training and a preregistered evaluation.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "lint:provenance": "node scripts/validate-provenance.mjs docs/provenance/manifest.example.jsonl",
    "check:quotes": "node scripts/check-provenance-quotes.mjs",
    "quotes:extract": "node scripts/extract-quotes.mjs",
    "quotes:verify": "node scripts/verify-quotes.mjs",
    "quotes:fetch": "bash scripts/fetch-quotes.sh",
    "price:sheets": "node scripts/price-dry-run.mjs --out docs/eval/pricing.sheets.md",
    "check:briefs": "node scripts/validate-briefs.mjs docs/eval/briefs/manifest.jsonl --expect-seal sha256:91d75f29afe10fa419b53fc412abdfaf970068d7725fe40c69894e64c36ed59e",
    "check:originals": "node scripts/verify-originals.mjs docs/provenance/manifest.example.jsonl",
    "pilot:scaffold": "node scripts/scaffold-pilot.mjs",
    "pilot:run": "node scripts/pilot.mjs",
    "pilot:corpus": "node scripts/pilot-corpus.mjs --record",
    "check:pilot-corpus": "node scripts/pilot-corpus.mjs --verify"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "hono": "^4.9.12",
    "htm": "^3.1.1",
    "preact": "^10.27.2",
    "preact-render-to-string": "^6.6.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vue": "^3.5.22"
  }
}
