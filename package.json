{
  "name": "mwg-train",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Experiment: does training on Modern Web Guidance-applied sites make a model default to modern web practice? Corpus, uplift pairing, adapter training and a preregistered evaluation.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "lint:provenance": "node scripts/validate-provenance.mjs docs/provenance/manifest.example.jsonl",
    "check:quotes": "node scripts/check-provenance-quotes.mjs",
    "quotes:extract": "node scripts/extract-quotes.mjs",
    "quotes:verify": "node scripts/verify-quotes.mjs",
    "quotes:fetch": "bash scripts/fetch-quotes.sh",
    "price:sheets": "node scripts/price-dry-run.mjs --out docs/eval/pricing.sheets.md",
    "check:briefs": "node scripts/validate-briefs.mjs docs/eval/briefs/manifest.jsonl --expect-seal sha256:89a1f47d638c5eab733074d87bc19d6615401aeb9a77ecbd86cf10b443e272b1",
    "check:disjoint": "node scripts/check-disjoint.mjs",
    "train:tokens": "node scripts/train-corpus-tokens.mjs",
    "targets:train:render": "node scripts/render-training-targets.mjs",
    "targets:train:check": "node scripts/render-training-targets.mjs --check",
    "scaffold:train-corpus": "node scripts/scaffold-training-corpus.mjs",
    "check:eval-projects": "node scripts/scaffold-eval-projects.mjs --check",
    "check:all": "npm run lint:provenance && npm run check:quotes && npm run check:briefs && npm run check:disjoint && npm run check:eval-projects && npm run check:targets && npm run check:specs && npm run check:pilot-corpus && npm run check:train-evidence && npm run scan:owner-auth && npm run check:brief-schema && npm run check:route-conformance && npm run check:rules-pin && npm run check:design-schema && npm run check:baseline-label",
    "render:targets": "node scripts/render-targets.mjs",
    "check:targets": "node scripts/render-targets.mjs --check && node scripts/validate-provenance.mjs data/A6_evaluation/targets/manifest.jsonl",
    "score:conformance": "node scripts/score-conformance.mjs",
    "score:identity": "node scripts/score-variant-identity.mjs",
    "check:specs": "node scripts/rebuild-from-spec.mjs --all",
    "rebuild:spec": "node scripts/rebuild-from-spec.mjs",
    "check:originals": "node scripts/verify-originals.mjs docs/provenance/manifest.jsonl --if-present",
    "pilot:scaffold": "node scripts/scaffold-pilot.mjs",
    "pilot:run": "node scripts/pilot.mjs",
    "pilot:corpus": "node scripts/pilot-corpus.mjs --record",
    "check:pilot-corpus": "node scripts/pilot-corpus.mjs --verify",
    "check:train-evidence": "node scripts/check-train-evidence.mjs",
    "price:two-backends": "node scripts/price-two-backends.mjs",
    "viewer": "node src/viewer/server.mjs",
    "scan:owner-auth": "node scripts/scan-owner-auth.mjs --corpus pilot && node scripts/scan-owner-auth.mjs docs/train/briefs docs/train/corpus",
    "promote": "node scripts/promote.mjs",
    "check:brief-schema": "node scripts/check-brief-schema.mjs",
    "check:route-conformance": "node scripts/check-route-conformance.mjs",
    "check:served-routes": "node scripts/check-served-routes.mjs",
    "check:served-routes:strict": "node scripts/check-served-routes.mjs --expect-all",
    "check:rules-pin": "node scripts/check-rules-pin.mjs",
    "check:cross-arm-parity": "node scripts/check-cross-arm-parity.mjs",
    "check:cross-arm-parity:strict": "node scripts/check-cross-arm-parity.mjs --strict",
    "cross-arm-parity:update": "node scripts/check-cross-arm-parity.mjs --write",
    "check:design-schema": "node scripts/check-design-schema.mjs",
    "check:baseline-label": "node scripts/check-baseline-label.mjs",
    "label:baseline": "node scripts/label-baseline.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "hono": "^4.9.12",
    "htm": "^3.1.1",
    "preact": "^10.27.2",
    "preact-render-to-string": "^6.6.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svelte": "5.57.2",
    "vue": "^3.5.22"
  }
}
