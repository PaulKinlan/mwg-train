{
  "project_id": "account-recovery-svelte",
  "archetype": "account-recovery",
  "archetype_title": "Account sign-in and recovery",
  "assets": {
    "archetype": "account-recovery",
    "store": "assets/archetypes/account-recovery",
    "brand": {
      "state": "brandless",
      "name": null,
      "mark": false,
      "mark_recorded_not_self_contained": false,
      "provisional": false
    },
    "tokens": {
      "colors": 10,
      "fonts": 1,
      "derived": {
        "fg": "--text",
        "bg": "--page",
        "accent": "--accent",
        "error": "--error",
        "fontStack": "--font-sans",
        "surfaceInput": "--field"
      }
    },
    "copy": [
      {
        "page": "compare.html",
        "title": "Account recovery · visual comparison"
      },
      {
        "page": "index.html",
        "title": "Account recovery · visual demo"
      }
    ],
    "images": [
      {
        "name": "step1-request.jpg",
        "sha256": "1a6989fb1979ebd0c7a1b8691f4df0f0843fdec994a8328ad54fc1756d187da2",
        "store_path": "assets/archetypes/account-recovery/step1-request.jpg"
      },
      {
        "name": "step2-sent.jpg",
        "sha256": "2ebfcab74be289c17db8b585e786cdc6757bd0c88cb81900dd7256cffbbb0eeb",
        "store_path": "assets/archetypes/account-recovery/step2-sent.jpg"
      },
      {
        "name": "step3-refusal.jpg",
        "sha256": "4d937b3ab1031b82ced3d36d181e2419501f7da22b3eeb6a9460f19515a82b38",
        "store_path": "assets/archetypes/account-recovery/step3-refusal.jpg"
      }
    ],
    "rights": {
      "excluded_from_training": true,
      "approved_for_training": false,
      "source": "docs/design/archetypes/account-recovery/README.md:5"
    }
  },
  "framework": {
    "name": "svelte",
    "version": "5.57.2",
    "dialect": "html",
    "markupFile": "app/page.svelte",
    "compiledFile": "app/page.compiled.mjs",
    "stylesFile": "app/styles.css",
    "enhanceFile": "app/enhance.js",
    "serverFile": "server.mjs",
    "family": "svelte"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "kind": "page"
    },
    {
      "method": "POST",
      "path": "/signup",
      "kind": "write-account"
    },
    {
      "method": "GET",
      "path": "/account",
      "kind": "read-session"
    },
    {
      "method": "POST",
      "path": "/reset",
      "kind": "write-reset"
    },
    {
      "method": "GET",
      "path": "/reset/:ref",
      "kind": "read-by-reference"
    }
  ],
  "fields": [
    {
      "slug": "email",
      "name": "email",
      "type": "email",
      "autocomplete": "username"
    },
    {
      "slug": "password",
      "name": "password",
      "type": "password",
      "autocomplete": "new-password"
    },
    {
      "slug": "displayName",
      "name": "displayName",
      "type": "text",
      "autocomplete": null
    }
  ],
  "seeded_defects": [
    "no-required",
    "eager-invalid",
    "no-aria-sync",
    "no-autofill"
  ],
  "journey": {
    "startPath": "/",
    "formSelector": "form#signup-form",
    "fill": {
      "input[name=email]": "alan@example.test",
      "input[name=password]": "correct horse battery",
      "input[name=displayName]": "Alan T"
    },
    "expectText": "Alan T"
  },
  "echo_expect": "Alan T",
  "content_journey": {
    "source": "session",
    "path": "/reset/REF",
    "param": null,
    "inputSelector": "[name=displayName]",
    "formSelector": "form#signup-form",
    "echoField": "displayName"
  },
  "echo_source": "session",
  "write_journey": null,
  "session_routes": [
    "/account"
  ],
  "echo_container": "#record-echo",
  "security_journey": {
    "path": "/",
    "formSelector": "form#signup-form",
    "fill": {}
  },
  "session": true,
  "check_context": {
    "formSelector": "form#signup-form",
    "primaryField": "[name=email]",
    "usernameField": "[name=email]",
    "passwordField": "[name=password]",
    "addressField": "[name=address]",
    "postcodeField": "[name=postcode]"
  },
  "primaryFields": [
    {
      "slug": "email",
      "name": "email",
      "elementPattern": "<input[^>]*name=\"email\"[^>]*>",
      "elementPatternFirst": "<input[^>]*name=\"email\"[^>]*>"
    },
    {
      "slug": "password",
      "name": "password",
      "elementPattern": "<input[^>]*name=\"password\"[^>]*>",
      "elementPatternFirst": "<input[^>]*name=\"password\"[^>]*>"
    },
    {
      "slug": "displayName",
      "name": "displayName",
      "elementPattern": "<input[^>]*name=\"displayName\"[^>]*>",
      "elementPatternFirst": "<input[^>]*name=\"displayName\"[^>]*>"
    }
  ],
  "autofill": {
    "usernamePattern": "(<input[^>]*type=\"email\"[^>]*>)",
    "passwordPattern": "(<input[^>]*type=\"password\"[^>]*>)",
    "streetPattern": "(<input[^>]*name=\"address\"[^>]*>)",
    "postcodePattern": "(<input[^>]*name=\"postcode\"[^>]*>)"
  },
  "required_rules": [
    "forms/required-field-feedback",
    "forms/validate-input-after-interaction",
    "accessibility/accessible-error-announcement",
    "security/sanitize-untrusted-html",
    "forms/autofill-sign-up-form"
  ]
}
