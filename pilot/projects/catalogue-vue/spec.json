      }
    ],
    "rights": {
      "excluded_from_training": true,
      "approved_for_training": false,
      "source": "docs/design/archetypes/catalogue/README.md:5"
    }
  },
  "framework": {
    "name": "vue",
    "version": "3.5.22",
    "dialect": "vue",
    "markupFile": "app/page.mjs",
    "stylesFile": "app/styles.css",
    "enhanceFile": "app/enhance.js",
    "serverFile": "server.mjs",
    "family": "vue"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "kind": "page"
    },
    {
      "method": "GET",
      "path": "/search",
      "kind": "search"
    },
    {
      "method": "POST",
      "path": "/cart",
      "kind": "write-session"
    },
    {
      "method": "GET",
      "path": "/cart",
      "kind": "read-session"
    }
  ],
  "fields": [
    {
      "slug": "query",
      "name": "q",
      "type": "search",
      "autocomplete": null
    },
    {
      "slug": "quantity",
      "name": "quantity",
      "type": "number",
      "autocomplete": null
    },
    {
      "slug": "item",
      "name": "item",
      "type": "text",
      "autocomplete": null
    }
  ],
  "seeded_defects": [],
  "journey": {
    "kind": "get-query-reload",
    "startPath": "/",
    "formSelector": "form#search-form",
    "fill": {
      "input[name=q]": "bearing"
    },
    "expectText": "bearing"
  },
  "echo_expect": "bearing",
  "content_journey": {
    "source": "query",
    "path": "/search",
    "param": "q",
    "inputSelector": "[name=q]",
    "formSelector": "form#search-form",
    "echoField": "query"
  },
  "echo_source": "query",
  "write_journey": {
    "startPath": "/",
    "formSelector": "form#cart-form",
    "itemField": "input[name=item]",
    "fill": {
      "input[name=quantity]": "2"
    },
    "readPath": "/api/records"
  },
  "session_routes": [
    "/cart"
  ],
  "echo_container": "#record-echo",
  "security_journey": null,
  "session": true,
  "check_context": {
    "formSelector": "form#search-form",
    "primaryField": "[name=q]",
    "usernameField": "[name=email]",
    "passwordField": "[name=password]",
    "addressField": "[name=address]",
    "postcodeField": "[name=postcode]"
  },
  "primaryFields": [
    {
      "slug": "query",
      "name": "q",
      "elementPattern": "<input[^>]*name=\"q\"[^>]*>",
      "elementPatternFirst": "<input[^>]*name=\"q\"[^>]*>"
    },
    {
      "slug": "item",
      "name": "item",
      "elementPattern": "<input[^>]*name=\"item\"[^>]*>",
      "elementPatternFirst": "<input[^>]*name=\"item\"[^>]*>"
    }
  ],
  "autofill": {
    "usernamePattern": "(<input[^>]*type=\"email\"[^>]*>)",
    "passwordPattern": "(<input[^>]*type=\"password\"[^>]*>)",
    "streetPattern": "(<input[^>]*name=\"address\"[^>]*>)",
    "postcodePattern": "(<input[^>]*name=\"postcode\"[^>]*>)"
  },
  "required_rules": [
    "forms/required-field-feedback",
    "forms/validate-input-after-interaction",
    "accessibility/accessible-error-announcement",
    "security/sanitize-untrusted-html"
  ]
}
