      },
      {
        "name": "step2-cart.jpg",
        "sha256": "864a10b7c056667af9c1972d399d1bff739d780cd673cd3bcc013e1cc6996adc",
        "store_path": "assets/archetypes/catalogue/step2-cart.jpg"
      },
      {
        "name": "step3-empty.jpg",
        "sha256": "9b8a4e58550892fef25ebab0a15c6078d0a40d8781292bfb2ba1be0ec384e9c0",
