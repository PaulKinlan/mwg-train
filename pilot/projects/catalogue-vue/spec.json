{
  "project_id": "catalogue-vue",
  "archetype": "catalogue",
  "archetype_title": "Searchable reference catalogue",
  "assets": {
    "archetype": "catalogue",
    "store": "assets/archetypes/catalogue",
    "brand": {
      "state": "named",
      "name": "Kiln & Copper",
      "mark": true,
      "mark_recorded_not_self_contained": false,
      "provisional": false
    },
    "tokens": {
      "colors": 29,
      "fonts": 2,
      "derived": {
        "fg": "--text-primary",
        "bg": "--bg-page",
        "accent": "--action",
        "error": "--danger",
        "fontStack": "--font-sans",
        "surfaceInput": "--surface-input"
      }
    },
    "copy": [
      {
        "page": "cart.html",
        "title": "Your Cart — Kiln &amp; Copper (static variant)"
      },
      {
        "page": "compare.html",
        "title": "Visual Design Comparison — Catalogue Archetype"
      },
      {
        "page": "empty.html",
        "title": "No Matches — Kiln &amp; Copper (static variant)"
      },
      {
        "page": "index.html",
        "title": "Kiln &amp; Copper — Ceramics &amp; Kiln Parts Catalogue"
      }
    ],
    "images": [
      {
        "name": "step1-grid.jpg",
        "sha256": "93f3b8c5056685e981e523b9c1550dd4d27f55a5a0ecd5fff82b0cf447c7f0cd",
