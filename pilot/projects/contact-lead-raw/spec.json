{
  "project_id": "contact-lead-raw",
  "archetype": "contact-lead",
  "archetype_title": "Public-service enquiry form",
  "framework": {
    "name": "raw",
    "version": "platform (no framework)",
    "dialect": "html",
    "family": "raw-web-platform",
    "markupFile": "app/page.mjs",
    "stylesFile": "app/styles.css",
    "enhanceFile": "app/enhance.js"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "kind": "page"
    },
    {
      "method": "POST",
      "path": "/enquiry",
      "kind": "write"
    },
    {
      "method": "GET",
      "path": "/enquiry/:ref",
      "kind": "read-by-reference"
    },
    {
      "method": "GET",
      "path": "/inbox",
      "kind": "list"
    }
  ],
  "fields": [
    {
      "slug": "name",
      "name": "name",
      "type": "text",
      "autocomplete": "name"
    },
    {
      "slug": "email",
      "name": "email",
      "type": "email",
      "autocomplete": "email"
    },
    {
      "slug": "message",
      "name": "message",
      "type": "textarea",
      "autocomplete": null
    }
  ],
  "seeded_defects": [
    "no-required",
    "eager-invalid",
    "no-aria-sync",
    "xss-innerhtml"
  ],
  "journey": {
    "startPath": "/",
    "formSelector": "form#enquiry-form",
    "fill": {
      "input[name=name]": "Grace Hopper",
      "input[name=email]": "grace@example.test",
      "textarea[name=message]": "Please repair the street light"
    },
    "expectText": "Grace Hopper"
  },
  "content_journey": {
    "path": "/enquiry/REF",
    "inputSelector": "[name=message]",
    "formSelector": "form#contact-lead-form",
    "echoField": "message"
  },
  "security_journey": null,
  "session": false,
  "check_context": {
    "formSelector": "form#contact-lead-form",
    "primaryField": "[name=name]",
    "usernameField": "[name=email]",
    "passwordField": "[name=password]",
    "addressField": "[name=address]",
    "postcodeField": "[name=postcode]"
  },
  "primaryFields": [
    {
      "slug": "name",
      "name": "name",
      "elementPattern": "<input[^>]*name=\"name\"[^>]*>",
      "elementPatternFirst": "<input[^>]*name=\"name\"[^>]*>"
    },
    {
      "slug": "email",
      "name": "email",
      "elementPattern": "<input[^>]*name=\"email\"[^>]*>",
      "elementPatternFirst": "<input[^>]*name=\"email\"[^>]*>"
    },
    {
      "slug": "message",
      "name": "message",
      "elementPattern": "<textarea[^>]*name=\"message\"[^>]*>",
      "elementPatternFirst": "<textarea[^>]*name=\"message\"[^>]*>"
    }
  ],
  "autofill": {
    "usernamePattern": "(<input[^>]*type=\"email\"[^>]*>)",
    "passwordPattern": "(<input[^>]*type=\"password\"[^>]*>)",
    "streetPattern": "(<input[^>]*name=\"address\"[^>]*>)",
    "postcodePattern": "(<input[^>]*name=\"postcode\"[^>]*>)"
  },
  "required_rules": [
    "forms/required-field-feedback",
    "forms/validate-input-after-interaction",
    "accessibility/accessible-error-announcement",
    "security/sanitize-untrusted-html"
  ]
}
