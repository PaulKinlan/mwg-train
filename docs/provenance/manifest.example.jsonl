# Example provenance manifest. Illustrative only: these are not real corpus assets, and no training
# run may select from this file.
#
# One JSON object per line. Lines starting with '#' and blank lines are ignored.
# Validate with: node scripts/validate-provenance.mjs docs/provenance/manifest.example.jsonl
#
# Field notes:
#   id                     immutable slug, unique across the manifest
#   arm                    A1_self_generated | A2_mwg_uplift_deterministic (trainable, needs approval)
#                          A3_teacher_generated | A5_black_box_reproduction (private, non-trainable)
#                          A4_clean_room_reproduction | A6_evaluation (public, non-trainable)
#   storage_path           must sit under data/<arm>/
#   generator.type         human | open-weight | deterministic | hosted-api | none
#                          hosted-api forces the row into A3_teacher_generated and requires
#                          provider, model, account_ref and terms_ref
#   rights_ref             the rights record under docs/provenance/ that covers this asset
#   excluded_from_training must be stated in a manifest row; makeRecord() fills it from the arm
#                          default when a record is built in code (true for the quarantined arms).
#                          Setting it false on a quarantined arm is rejected outright.
#   approved_for_training  never a default; true requires approved_by and approved_at
#   parents                asset ids this asset was derived from (used by the quarantined-ancestor check)
#   original_ref/sha/tree  the retained ref that keeps the original alive, with its commit and tree.
#                          Required for kind original/reproduction/evaluation; the ref must be named
#                          for the row's asset id. See docs/provenance/original-refs.md.
#   retention              where that ref lives and what keeps it alive (repo + at least one protection)
#
# The refs and shas in this example are PLACEHOLDERS: the file is illustrative and is not backed by a
# repository, so scripts/verify-originals.mjs reports REF_UNRESOLVED for them - which is the gate
# working correctly on a corpus that does not exist yet.
{"id":"example-eval-brief-0001","arm":"A6_evaluation","kind":"evaluation","storage_path":"data/A6_evaluation/briefs/example-eval-brief-0001","generator":{"type":"human"},"rights_ref":"docs/provenance/assets/reproduction-studies.md","created_at":"2026-10-08","excluded_from_training":true,"approved_for_training":false,"parents":[],"original_ref":"refs/tags/original/example-eval-brief-0001","original_sha":"5555555555555555555555555555555555555555","original_tree":"6666666666666666666666666666666666666666","retention":{"repo":"/srv/mwg-train-originals","url":"git@example.invalid:mwg-train-originals.git","protections":["annotated tag refs/tags/original/* - not a branch, so a branch prune cannot reach it","server-side tag protection and receive.denyDeletes on refs/tags/original/*","the originals repository history is never rewritten"]}}
